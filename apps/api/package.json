{
  "name": "@qrew/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx src/cli/reset-db.ts",
    "bootstrap:admin": "tsx src/cli/bootstrap-super-admin.ts",
    "bootstrap:super-admin": "tsx src/cli/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "@hono/node-server": "^2.1.9",
    "@hono/zod-openapi": "^1.6.3",
    "@qrew/contracts": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.22",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@qrew/config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
