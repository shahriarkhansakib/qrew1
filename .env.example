# Database (PostgreSQL 18 via Docker Compose on port 54329)
DATABASE_URL=postgresql://qrew:qrew_dev_password@localhost:54329/qrew

# Better Auth
# Must be >= 32 characters in all environments
BETTER_AUTH_SECRET=replace-with-at-least-32-character-random-secret
# Public origin + auth base path seen by browser and OAuth callbacks
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Frontend / Backend Origins
WEB_PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:8787
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Google OAuth (required for Google sign-in; use test placeholders locally if not testing live OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=10259
SMTP_FROM=no-reply@qrew.local
MAILPIT_API_URL=http://localhost:8029
